# Copy to .env and fill in. .env is gitignored.
# NexAssure resolves ${env:VAR} references at config load time.

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=xy12345.eu-west-1
SNOWFLAKE_USER=data_quality
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- PostgreSQL ---
PGHOST=localhost
PGUSER=data_quality
PGPASSWORD=

# --- SQL Server / Synapse ---
MSSQL_USER=data_quality
MSSQL_PASSWORD=
SYNAPSE_USER=data_quality
SYNAPSE_PASSWORD=

# --- Redshift ---
REDSHIFT_USER=data_quality
REDSHIFT_PASSWORD=

# --- Oracle ---
ORACLE_USER=DATA_QUALITY
ORACLE_PASSWORD=

# --- MySQL ---
MYSQL_USER=data_quality
MYSQL_PASSWORD=

# --- NexAssure ---
# Shared metastore. Omit for a local SQLite file under ~/.nexassure
# NEXASSURE_METASTORE_URL=postgresql+psycopg://nexassure:pw@metastore:5432/nexassure
# NEXASSURE_LOG_FORMAT=json
# NEXASSURE_API_TOKEN=
# SLACK_WEBHOOK_URL=
